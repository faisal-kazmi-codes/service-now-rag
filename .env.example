# ServiceNow
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# API server port (optional, default 6789)
PORT=6789

# Pinecone (RAG ingest)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=servicenow-rag

# OpenAI (embeddings)
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=512
EMBED_BATCH_SIZE=100

# Chunking (tokens)
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# OpenAI (chat for RAG)
OPENAI_CHAT_MODEL=gpt-4.1
